# Copy to .env.local for local development. Never commit real secrets.

# Supabase: Dashboard -> Project Settings -> API Keys (locally: `npm run db:start` prints these)
# Newer projects call these the "publishable" and "secret" keys; either naming works:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are accepted in place of the two below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# "anthropic" (default) or "mock" (recorded fixtures; used by E2E tests)
AI_PROVIDER=anthropic
# Hard monthly AI spend cap per user, in US dollars
AI_MONTHLY_COST_CAP_USD=5

# Stripe (test mode first): dashboard.stripe.com -> Developers -> API keys; Products -> Pro
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Public site URL (links, Stripe redirects, sitemap, social previews).
# Optional on Vercel: it falls back to the project's production domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on the Contact, Privacy and Terms pages. Required for production builds.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: privacy-friendly analytics (Plausible-compatible, no cookies)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Optional: script URL for a self-hosted or compatible service (defaults to plausible.io)
NEXT_PUBLIC_ANALYTICS_SRC=
